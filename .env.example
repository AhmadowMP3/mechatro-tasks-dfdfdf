# Self-hosted deployment (VPS / Coolify).
# These values are already baked into the Dockerfile, so `docker compose up -d --build`
# works with no .env at all. Set them here only to target a different backend.

# --- Build time (inlined into the browser bundle) ---
VITE_SUPABASE_URL=https://supabase.mechatro-sy.com
VITE_SUPABASE_PUBLISHABLE_KEY=<anon key>
VITE_SUPABASE_PROJECT_ID=mechatro

# --- Runtime (SSR + server functions) ---
SUPABASE_URL=https://supabase.mechatro-sy.com
SUPABASE_PUBLISHABLE_KEY=<anon key>
SUPABASE_PROJECT_ID=mechatro

# Optional, only for privileged server-side maintenance work.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Google Drive backup sync (SSR + server functions of THIS app) ---
# Required for the "Connect Google account" button in Settings.
# Without them the app throws `oauth_not_configured`.
# Set these on the dashboard app container (Coolify -> app resource -> Environment Variables).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Needed by /api/public/google/drive-callback to store the refresh token.
SUPABASE_SERVICE_ROLE_KEY=

# --- Word engine (exact "Import from Word") ---
# Set automatically by docker-compose.yml (the bundled `gotenberg` service).
# Override only if the engine runs elsewhere; add basic-auth if it is public.
# GOTENBERG_URL=http://gotenberg:3000
# GOTENBERG_USERNAME=
# GOTENBERG_PASSWORD=
