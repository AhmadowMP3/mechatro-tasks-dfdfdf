# ---------------------------------------------------------------------------
# Option B: static SPA image (nginx:alpine only).
#
# WARNING: this app is TanStack Start (SSR). This image serves only the client
# bundle plus a prerendered HTML shell, so the following STOP WORKING:
#   - server functions (Notes AI assistant, test-user provisioning)
#   - the public webhook route /api/public/hooks/backup-auto-approve
#   - server-side rendering / SEO metadata per route
# Use Dockerfile (Option A) unless you explicitly accept those losses.
# ---------------------------------------------------------------------------

# ---------- Stage 1: build ----------
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
# The lockfile may lag behind package.json (the project also uses bun), so fall
# back to a plain install instead of failing the build.
RUN npm ci --include=dev || npm install --include=dev --no-audit --no-fund

COPY . .

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_SUPABASE_PROJECT_ID
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY \
    VITE_SUPABASE_PROJECT_ID=$VITE_SUPABASE_PROJECT_ID \
    NODE_ENV=production

RUN npx vite build --config vite.deploy.config.ts

# The framework emits no index.html, so snapshot the rendered shell from the
# built server once and ship it as the SPA entry document.
RUN node -e "\
const { spawn } = require('child_process');\
const s = spawn('node', ['.output/server/index.mjs'], { env: { ...process.env, PORT: '3123' }, stdio: 'inherit' });\
const wait = async () => { for (let i = 0; i < 60; i++) { try { const r = await fetch('http://127.0.0.1:3123/'); if (r.ok) return await r.text(); } catch {} await new Promise(r => setTimeout(r, 500)); } throw new Error('server did not start'); };\
wait().then(html => { require('fs').writeFileSync('.output/public/index.html', html); s.kill(); process.exit(0); }).catch(e => { console.error(e); s.kill(); process.exit(1); });\
"

# ---------- Stage 2: serve ----------
FROM nginx:alpine AS runner

COPY --from=builder /app/.output/public /usr/share/nginx/html
COPY nginx.spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
